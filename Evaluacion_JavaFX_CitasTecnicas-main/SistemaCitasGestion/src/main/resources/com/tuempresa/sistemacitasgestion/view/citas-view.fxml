<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<?import java.lang.String?>
<VBox fx:id="panelPrincipal" spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tuempresa.sistemacitasgestion.controller.CitaController">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <VBox spacing="3">
        <Label text="Citas técnicas" styleClass="pagina-titulo"/>
        <Label text="Organiza las visitas, servicios y estados de atención."
               styleClass="pagina-descripcion"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra-filtros">
        <Label text="FILTRAR" styleClass="filtro-titulo"/>
        <ComboBox fx:id="cmbFiltroEstado" promptText="Estado" prefWidth="180">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Pendiente"/>
                    <String fx:value="En proceso"/>
                    <String fx:value="Finalizada"/>
                    <String fx:value="Cancelada"/>
                </FXCollections>
            </items>
        </ComboBox>
        <DatePicker fx:id="dpFiltroFecha" promptText="Fecha" prefWidth="160"/>
        <Button text="Limpiar filtros" styleClass="boton-secundario" onAction="#limpiarFiltros"/>
    </HBox>


    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="6" styleClass="tarjeta formulario" prefWidth="320" minWidth="320">
            <Label text="Detalle de la cita" styleClass="seccion-titulo"/>
            <Label text="Asigna un cliente y define los datos del servicio."
                   styleClass="seccion-descripcion" wrapText="true"/>
            <Label text="Cliente" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity"/>
            <HBox spacing="8">
                <VBox spacing="4" prefWidth="100" HBox.hgrow="ALWAYS">
                    <Label text="Fecha" styleClass="etiqueta"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" prefWidth="100" HBox.hgrow="ALWAYS">
                    <Label text="Hora (HH:mm)" styleClass="etiqueta"/>
                    <TextField fx:id="txtHora" promptText="09:30"/>
                </VBox>
            </HBox>
            <HBox spacing="8">
                <VBox spacing="4" prefWidth="100" HBox.hgrow="ALWAYS">
                    <Label text="Servicio" styleClass="etiqueta"/>
                    <TextField fx:id="txtServicio"/>
                </VBox>
                <VBox spacing="4" prefWidth="100" HBox.hgrow="ALWAYS">
                    <Label text="Estado" styleClass="etiqueta"/>
                    <ComboBox fx:id="cmbEstado" value="Pendiente" maxWidth="Infinity">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Pendiente"/>
                                <String fx:value="En proceso"/>
                                <String fx:value="Finalizada"/>
                                <String fx:value="Cancelada"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
            </HBox>
            <Label text="Descripción" styleClass="etiqueta"/>
            <TextArea fx:id="txtDescripcion" prefRowCount="2" wrapText="true"/>
            <HBox spacing="8">
                <Button text="Guardar" styleClass="boton-primario" onAction="#guardar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Eliminar" styleClass="boton-peligro" onAction="#eliminar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Limpiar" styleClass="boton-secundario" onAction="#limpiar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>


        <VBox spacing="10" styleClass="tarjeta listado" HBox.hgrow="ALWAYS">
            <VBox spacing="3">
                <Label text="Agenda de servicio" styleClass="seccion-titulo"/>
                <Label text="Selecciona una cita para consultar o actualizar su estado."
                       styleClass="seccion-descripcion"/>
            </VBox>
            <TableView fx:id="tablaCitas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
                    <TableColumn fx:id="colHora" text="Hora" prefWidth="70"/>
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="150"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>