<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="panelPrincipal" spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tuempresa.sistemacitasgestion.controller.ClienteController">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <VBox spacing="3">
        <Label text="Clientes" styleClass="pagina-titulo"/>
        <Label text="Administra la información de contacto y el estado de tus clientes."
               styleClass="pagina-descripcion"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, apellido o correo"
                   styleClass="campo-busqueda" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" styleClass="boton-primario" onAction="#buscar"/>
        <Button text="Ver todos" styleClass="boton-secundario" onAction="#verTodos"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="8" styleClass="tarjeta formulario" prefWidth="300" minWidth="300">
            <Label text="Ficha del cliente" styleClass="seccion-titulo"/>
            <Label text="Completa los datos para registrar o editar."
                   styleClass="seccion-descripcion" wrapText="true"/>
            <Label text="Nombres" styleClass="etiqueta"/>
            <TextField fx:id="txtNombres"/>
            <Label text="Apellidos" styleClass="etiqueta"/>
            <TextField fx:id="txtApellidos"/>
            <Label text="Teléfono" styleClass="etiqueta"/>
            <TextField fx:id="txtTelefono"/>
            <Label text="Correo" styleClass="etiqueta"/>
            <TextField fx:id="txtCorreo"/>
            <CheckBox fx:id="chkActivo" text="Cliente activo" selected="true"/>
            <HBox spacing="8">
                <Button text="Guardar" styleClass="boton-primario" onAction="#guardar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Actualizar" styleClass="boton-secundario" onAction="#actualizar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Eliminar" styleClass="boton-peligro" onAction="#eliminar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Limpiar" styleClass="boton-secundario" onAction="#limpiar"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>

        <VBox spacing="10" styleClass="tarjeta listado" HBox.hgrow="ALWAYS">
            <VBox spacing="3">
                <Label text="Directorio de clientes" styleClass="seccion-titulo"/>
                <Label text="Selecciona una fila para consultar o editar su información."
                       styleClass="seccion-descripcion"/>
            </VBox>
            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="200"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colActivo" text="Activo" prefWidth="70"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>