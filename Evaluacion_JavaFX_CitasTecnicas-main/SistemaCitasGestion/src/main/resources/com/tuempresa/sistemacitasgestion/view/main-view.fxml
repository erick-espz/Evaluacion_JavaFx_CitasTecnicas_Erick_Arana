<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox styleClass="encabezado" alignment="CENTER_LEFT" spacing="12">
            <Label text="H" styleClass="marca"/>
            <VBox spacing="2">
                <Label text="HexTech" styleClass="encabezado-titulo"/>
                <Label text="Gestión de servicio técnico" styleClass="encabezado-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="CLIENTES  /  CITAS" styleClass="encabezado-contexto"/>
        </HBox>
    </top>
    <center>
        <TabPane styleClass="navegacion" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Clientes">
                <fx:include source="cliente-view.fxml"/>
            </Tab>
            <Tab text="Citas">
                <fx:include source="citas-view.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>