<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox styleClass="encabezado" spacing="2">
            <Label text="TecnoAsistencia Nicaragua" styleClass="encabezado-titulo"/>
            <Label text="Gestión de clientes y citas técnicas" styleClass="encabezado-sub"/>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Clientes">
                <fx:include source="cliente-view.fxml"/>
            </Tab>
            <Tab text="Citas">
                <fx:include source="citas-view.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>